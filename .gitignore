# Build outputs
dist/
*.d.ts

# Generated API reference. docs/ is a tracked directory of hand-written
# contract docs (*.md), so a JSDoc run pointed at it would otherwise leave
# dozens of generated pages staged-able alongside them.
docs/*.html
docs/fonts/
docs/scripts/
docs/styles/

# Dependencies
node_modules/

# Test coverage
coverage/
.nyc_output/

# Benchmark results
bench/results.json

# Logs
*.log

# Caches
.cache/
.npm/
.rollup.cache/

# Environment variables
.env
.env.*
!.env.example

# Package artifacts
*.tgz

# Alternative lock files (keep only package-lock.json)
pnpm-lock.yaml
yarn.lock
bun.lock
bun.lockb

# AI assistants
.claude/
.cursor/

# OS-specific
.DS_Store
Thumbs.db

# IDE & Editor
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
*.swp
*.swo

# Temporary files
*.tmp
*.temp
.tmp/
.temp/

# Local CI testing
.secrets
.act/

# Built GitHub Pages output (site/ + dist/ + generated manifest)
_site/
