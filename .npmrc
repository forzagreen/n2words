# npm 12's install defaults, held from npm 11.16 on.
#
# A dependency's install script runs only if package.json's allowScripts
# allows it. One it doesn't name fails the install, where npm 12 would
# install without running it and npm 11 would run it with a notice, so each
# one is decided in allowScripts.
strict-allow-scripts=true

# No dependency is fetched from git or from a remote URL.
allow-git=none
allow-remote=none
