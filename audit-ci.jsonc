// audit-ci fails CI on any high or critical `npm audit` advisory (the Security
// audit step in .github/workflows/ci.yml). npm audit itself can't set an
// advisory aside, so each exception lives here with its reason and an expiry:
// once the date passes the advisory fails the gate again, and the exception is
// re-checked or dropped.
{
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  "high": true,
  "allowlist": []
}
